+#pragma once
+
+class QQuickWindow;
+
+namespace qs::window {
+
+// Makes the window render through the process-wide VkDevice instead of creating
+// its own. Does nothing unless the scene graph uses Vulkan. Must be called before
+// the window is first exposed.
+void useSharedVulkanDevice(QQuickWindow* window);
+
+} // namespace qs::window
