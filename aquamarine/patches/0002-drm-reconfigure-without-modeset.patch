diff --git a/src/backend/drm/DRM.cpp b/src/backend/drm/DRM.cpp
index bfda47c..62d822e 100644
--- a/src/backend/drm/DRM.cpp
+++ b/src/backend/drm/DRM.cpp
@@ -2590,6 +2590,13 @@ bool Aquamarine::CDRMOutput::commitState(bool onlyTest) {
     // which may result in some glitches
     const bool NEEDS_RECONFIG = SNAPSHOT.needsReconfig();
 
+    // A new format or new HDR metadata may only need a flip with a buffer. Try it without a modeset first, the retry
+    // below modesets if the driver rejects it.
+    const bool NO_MODESET_RECONFIG = NEEDS_RECONFIG && STATE.enabled && !lastCommitNoBuffer && (COMMITTED & COutputState::eOutputStateProperties::AQ_OUTPUT_STATE_BUFFER) &&
+        !(COMMITTED & (COutputState::AQ_OUTPUT_STATE_ENABLED | COutputState::AQ_OUTPUT_STATE_MODE | COutputState::AQ_OUTPUT_STATE_WCG | COutputState::AQ_OUTPUT_STATE_MAX_BPC)) &&
+        !connector->sched.frameInFlight() && !connector->commitTainted;
+    const bool MODESET = NEEDS_RECONFIG && !NO_MODESET_RECONFIG;
+
     const bool BLOCKING = NEEDS_RECONFIG || !(COMMITTED & COutputState::eOutputStateProperties::AQ_OUTPUT_STATE_BUFFER);
 
     const auto MODE = STATE.mode ? STATE.mode : STATE.customMode;
@@ -2600,7 +2607,9 @@ bool Aquamarine::CDRMOutput::commitState(bool onlyTest) {
     uint32_t flags = 0;
 
     if (!onlyTest) {
-        if (NEEDS_RECONFIG) {
+        if (NO_MODESET_RECONFIG)
+            backend->backend->log(AQ_LOG_DEBUG, std::format("drm: Reconfiguring {} without a modeset, format {}", name, fourccToName(STATE.drmFormat)));
+        else if (NEEDS_RECONFIG) {
             if (STATE.enabled)
                 backend->backend->log(AQ_LOG_DEBUG,
                                       std::format("drm: Modesetting {} with {}x{}@{:.2f}Hz", name, (int)MODE->pixelSize.x, (int)MODE->pixelSize.y, MODE->refreshRate / 1000.F));
@@ -2802,7 +2811,7 @@ bool Aquamarine::CDRMOutput::commitState(bool onlyTest) {
         data.hdrMetadata = STATE.hdrMetadata;
 
     data.blocking  = BLOCKING || formatMismatch;
-    data.modeset   = NEEDS_RECONFIG || lastCommitNoBuffer || formatMismatch;
+    data.modeset   = MODESET || lastCommitNoBuffer || formatMismatch;
     data.flags     = flags;
     data.test      = onlyTest;
     data.enabled   = STATE.enabled;
@@ -2844,6 +2853,9 @@ bool Aquamarine::CDRMOutput::commitState(bool onlyTest) {
         swapchain->rollback();
 
     if (!ok && !data.modeset && !connector->commitTainted) {
+        if (NO_MODESET_RECONFIG && !onlyTest)
+            backend->backend->log(AQ_LOG_DEBUG, std::format("drm: Reconfiguring {} without a modeset failed, modesetting", name));
+
         // attempt to re-modeset, however, flip a tainted flag if the modesetting fails
         // to avoid doing this over and over.
         data.modeset  = true;
