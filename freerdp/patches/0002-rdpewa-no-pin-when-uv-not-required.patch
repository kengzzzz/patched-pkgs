+static bool rdpewa_fido_uv_not_required(UINT32 flags)
+{
+	const UINT32 uvFlags = CTAPCLT_UV_REQUIRED_FLAG | CTAPCLT_UV_PREFERRED_FLAG |
+	                       CTAPCLT_CLIENT_PIN_REQUIRED_FLAG |
+	                       CTAPCLT_SELECT_CREDENTIAL_ALLOW_UV_FLAG;
+	return ((flags & CTAPCLT_UV_NOT_REQUIRED_FLAG) != 0) && ((flags & uvFlags) == 0);
+}
+
+/* Without a PIN, alwaysUv keys refuse and credProtect hides credentials */
+static bool rdpewa_fido_pin_needed(const fido_dev_t* dev, int result)
+{
+	if (result == FIDO_ERR_PIN_REQUIRED)
+		return true;
+	return (result == FIDO_ERR_NO_CREDENTIALS) && fido_dev_supports_cred_prot(dev);
+}
