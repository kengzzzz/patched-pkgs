+bool CMonitor::canScanoutBuffer(const SP<IHLBuffer>& buffer, const Aquamarine::SDMABUFAttrs& attrs) {
+    if (!m_output)
+        return false;
+
+    // aquamarine already failed to import this one into KMS
+    if (buffer->attachments.has<Aquamarine::CDRMBufferUnimportable>())
+        return false;
+
+    // KMS only takes a format + modifier the primary plane lists (e.g. NVIDIA's Vulkan WSI picks compressed modifiers it doesn't).
+    // Finding that out by attempting costs a swapchain reconfigure and a modeset whenever the format differs from the output's.
+    const auto FORMATS = m_output->getRenderFormats();
+    if (FORMATS.empty())
+        return true; // nothing to check against
+
+    const auto FORMAT = std::ranges::find_if(FORMATS, [&attrs](const auto& f) { return f.drmFormat == attrs.format; });
+    return FORMAT != FORMATS.end() && std::ranges::find(FORMAT->modifiers, attrs.modifier) != FORMAT->modifiers.end();
+}
