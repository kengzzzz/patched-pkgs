+
     m_scanoutNeedsCursorUpdate = false;
 
     if (!PBUFFER->lockedByBackend || PBUFFER->m_hlEvents.backendRelease)
diff --git a/src/render/Renderer.cpp b/src/render/Renderer.cpp
index aa5b81dd..824b9659 100644
--- a/src/render/Renderer.cpp
+++ b/src/render/Renderer.cpp
@@ -2315,6 +2315,13 @@ void IHyprRenderer::renderMonitor(PHLMONITOR pMonitor, bool commit) {
         return;
     }
 
+    // a torn frame can't be committed over a pending flip, e.g. a vsync flip from before tearing started, so draw it when the flip completes
+    if (pMonitor->m_tearingState.nextRenderTorn && pMonitor->m_output->pendingPageFlip()) {
+        if (pMonitor->m_tearingState.activelyTearing)
+            pMonitor->m_tearingState.frameScheduledWhileBusy = true;
+        return;
+    }
+
     if (*PDEBUGOVERLAY == 1)
         Debug::overlay()->frameData(pMonitor);
 
