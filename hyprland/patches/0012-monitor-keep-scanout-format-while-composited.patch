+// RGB formats the renderer draws into like the monitor's own
+static bool canKeepScanoutFormat(uint32_t format) {
+    switch (format) {
+        case DRM_FORMAT_XRGB8888:
+        case DRM_FORMAT_ARGB8888:
+        case DRM_FORMAT_XBGR8888:
+        case DRM_FORMAT_ABGR8888:
+        case DRM_FORMAT_XRGB2101010:
+        case DRM_FORMAT_ARGB2101010:
+        case DRM_FORMAT_XBGR2101010:
+        case DRM_FORMAT_ABGR2101010: return true;
+        case DRM_FORMAT_XBGR16161616F:
+        case DRM_FORMAT_ABGR16161616F: return g_pHyprRenderer->fp16Supported();
+        default: return false;
+    }
+}
+
 void CMonitor::handleDSleave() {
     LOG(Log::DEBUG, "Left a direct scanout.");
+    const auto LASTSCANOUT = m_lastScanout.lock();
     m_lastScanout.reset();
     m_previousFSWindow.reset(); // recalc fs settings
     m_directScanoutIsActive = false;
 
+    // a window that is still fullscreen is only composited for a while, e.g. under an OSD. Keeping its format
+    // means the swapchain isn't reallocated when compositing starts and again when scanout resumes.
+    if (LASTSCANOUT && canKeepScanoutFormat(m_drmFormat) && LASTSCANOUT == Fullscreen::controller()->getFullscreenWindow(m_self.lock())) {
+        m_scanoutFormatWindow = LASTSCANOUT;
+        m_scanoutFormatKept   = true;
+    } else
+        restoreFormatAfterDS();
+
+    m_blurFBDirty = true;
+    m_damage.damageEntire();
+}
+
+void CMonitor::checkKeptScanoutFormat() {
+    const auto WINDOW = m_scanoutFormatWindow.lock();
+    if (WINDOW && WINDOW == Fullscreen::controller()->getFullscreenWindow(m_self.lock()))
+        return;
+
+    restoreFormatAfterDS();
+    m_blurFBDirty = true;
+    m_damage.damageEntire();
+}
+
+void CMonitor::restoreFormatAfterDS() {
+    m_scanoutFormatWindow.reset();
+    m_scanoutFormatKept = false;
+
     // reset DRM format, but only if needed since it might modeset
     if (m_output->state->state().drmFormat != m_prevDrmFormat)
         m_output->state->setFormat(m_prevDrmFormat);
 
-    m_drmFormat   = m_prevDrmFormat;
-    m_blurFBDirty = true;
-    m_damage.damageEntire();
+    m_drmFormat = m_prevDrmFormat;
 }
 
