@@ -2,7 +2,18 @@
 
 #include "Fadeout.hpp"
 
+#include <algorithm>
+
 namespace Desktop {
+    // A blurred layer fades its blur over the first half of its fade and its pixels over the second half, so its content never shows over a sharp background.
+    inline float layerFadeBlurAlpha(float fade) {
+        return std::clamp(fade * 2.F, 0.F, 1.F);
+    }
+
+    inline float layerFadeContentAlpha(float fade) {
+        return std::clamp((fade * 2.F) - 1.F, 0.F, 1.F);
+    }
+
