+PHLMONITOR CLinuxDMABufV1Protocol::scanoutMonitorFor(SP<CWLSurfaceResource> surface) {
+    const auto ROOT = rootSurface(surface);
+    if (!ROOT)
+        return nullptr;
+
+    for (auto const& [other, monitor] : m_scanoutSurfaces) {
+        if (other.lock() == ROOT)
+            return monitor.lock();
+    }
+
+    return nullptr;
+}
+
 void CLinuxDMABufV1Protocol::updateScanoutTranche(SP<CWLSurfaceResource> surface, PHLMONITOR pMonitor) {
+    const auto ROOT = rootSurface(surface);
+
+    std::erase_if(m_scanoutSurfaces, [&](const auto& other) { return other.first.expired() || other.first.lock() == ROOT; });
+
+    if (pMonitor && ROOT)
+        m_scanoutSurfaces.emplace_back(ROOT, pMonitor);
+
     for (auto const& f : m_feedbacks) {
-        if (f->m_surface != surface)
+        if (!f->m_surface || rootSurface(f->m_surface) != ROOT)
             continue;
 
         f->sendScanoutFeedback(pMonitor);
