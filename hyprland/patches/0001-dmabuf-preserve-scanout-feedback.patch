+// the surface at the root of a subsurface tree. Clients like wine render into a subsurface of the toplevel,
+// and the toplevel is what goes fullscreen.
+static SP<CWLSurfaceResource> rootSurface(SP<CWLSurfaceResource> surface) {
+    std::vector<SP<CWLSurfaceResource>> visited;
+
+    while (surface && surface->m_role && surface->m_role->role() == SURFACE_ROLE_SUBSURFACE && std::ranges::find(visited, surface) == visited.end()) {
+        visited.emplace_back(surface);
+
+        const auto SUBSURFACE = sc<CSubsurfaceRole*>(surface->m_role.get())->m_subsurface.lock();
+        if (!SUBSURFACE || !SUBSURFACE->m_parent)
+            break;
+
+        surface = SUBSURFACE->m_parent.lock();
+    }
+
+    return surface;
+}
