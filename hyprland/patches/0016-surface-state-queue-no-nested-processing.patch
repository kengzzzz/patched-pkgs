 void CSurfaceStateQueue::tryProcess() {
+    // commitState() runs commit listeners that can unlock this queue again, e.g. direct scanout of the same
+    // buffer unlocks fifo. A nested pass would commit the front state twice, so leave it to this loop.
+    if (m_processing)
+        return;
+
+    m_processing = true;
+
     while (!m_queue.empty()) {
         auto& front = m_queue.front();
 
@@ -108,4 +115,6 @@ void CSurfaceStateQueue::tryProcess() {
         m_surface->commitState(*front);
         m_queue.pop_front();
     }
+
+    m_processing = false;
 }
