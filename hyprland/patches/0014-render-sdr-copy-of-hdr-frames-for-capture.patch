--- a/src/render/shaders/glsl/cm_helpers.glsl
+++ b/src/render/shaders/glsl/cm_helpers.glsl
@@ -200,6 +200,26 @@ vec4 fromLinearNit(vec4 color, int tf, vec2 range) {
     return color;
 }
 
+#if USE_MIRROR
+uniform float mirrorRefLuminance;
+uniform int   mirrorWorkTF;
+uniform vec2  mirrorWorkTFRange;
+uniform vec2  mirrorSDRTFRange;
+uniform float mirrorSDRBrightness;
+
+// Undoes the SDR to work buffer mapping for colors that are already in the FP16 work buffer, like the blurred background.
+// A PQ work buffer is left alone: its blur has the SDR brightness divided out already, and its primaries aren't sRGB.
+vec4 workToMirror(vec4 color) {
+    if (mirrorWorkTF != CM_TRANSFER_FUNCTION_EXT_LINEAR || color.a <= 0.0)
+        return color;
+
+    color.rgb /= color.a * mirrorSDRBrightness;
+    color = toNit(color, mirrorWorkTFRange);
+    color.rgb *= color.a;
+    return fromLinearNit(color, CM_TRANSFER_FUNCTION_SRGB, mirrorSDRTFRange);
+}
+#endif
+
 #if USE_TONEMAP
 #include "tonemap.glsl"
 #endif
